// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [
				"$tsc"
			],
			"label": "npm: build"
		},
		{
			"label": "Open Extension Host 2",
			"type": "shell",
			"command": "code",
			"args": [
				"--new-window",
				"--extensionDevelopmentPath=${workspaceFolder}",
				"--user-data-dir=${workspaceFolder}/.vscode-test/user-data-2"
			],
			"dependsOn": "npm: build",
			"problemMatcher": []
		}
	]
}
